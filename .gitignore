# Orca workspace state: tooling, not project content
.orca/

# Local, machine-specific device pointer. Never committed.
# The example file is tracked so the shape stays easy to find.
/.local/*
!/.local/device.example.json

.venv/
__pycache__/

# pytest-cov's data file; coverage is reported in the terminal, never stored.
.coverage

# Tool caches.
.pytest_cache/
.mypy_cache/
.ruff_cache/

uv.lock
